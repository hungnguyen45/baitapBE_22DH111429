@model baitapBE_22DH111429.Models.CategoryEditViewModel
@{ ViewBag.Title="Sửa danh mục"; Layout="~/Areas/Admin/Views/Shared/_Layout.cshtml"; }
<h2>Sửa danh mục</h2>
@using(Html.BeginForm()){ @Html.AntiForgeryToken() @Html.HiddenFor(m=>m.CategoryID) @Html.ValidationSummary(true,"",new{@class="text-danger"}) @Html.LabelFor(m=>m.CategoryName,new{@class="form-label"}) @Html.TextBoxFor(m=>m.CategoryName,new{@class="form-control",maxlength="100"}) @Html.ValidationMessageFor(m=>m.CategoryName,"",new{@class="text-danger"}) <div class="mt-3"><button class="btn btn-primary">Lưu</button> <a class="btn btn-secondary" href="@Url.Action("Index")">Hủy</a></div> }
