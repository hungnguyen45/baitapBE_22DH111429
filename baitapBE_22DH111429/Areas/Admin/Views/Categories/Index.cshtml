@model IEnumerable<baitapBE_22DH111429.Models.Category>
@{ ViewBag.Title="Quản lý danh mục"; Layout="~/Areas/Admin/Views/Shared/_Layout.cshtml"; }
<h2>Quản lý danh mục</h2>
@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> } @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }
<p>@Html.ActionLink("Thêm danh mục", "Create", null, new { @class="btn btn-primary" })</p>
<table class="table table-striped"><thead><tr><th>Tên danh mục</th><th>Số sản phẩm</th><th>Thao tác</th></tr></thead><tbody>@foreach(var c in Model){<tr><td>@c.CategoryName</td><td>@c.Product.Count</td><td>@Html.ActionLink("Sửa","Edit",new{id=c.CategoryID},new{@class="btn btn-sm btn-outline-primary"}) @Html.ActionLink("Xóa","Delete",new{id=c.CategoryID},new{@class="btn btn-sm btn-outline-danger"})</td></tr>}</tbody></table>
