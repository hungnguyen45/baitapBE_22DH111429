@model IEnumerable<baitapBE_22DH111429.Models.Order>
@{ ViewBag.Title = "Quản lý đơn hàng"; Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml"; }
<h2>Quản lý đơn hàng</h2>
<form method="get" class="row g-2 mb-3">
 <div class="col-md-3"><input class="form-control" name="customerName" value="@ViewBag.CustomerName" placeholder="Tên khách hàng" /></div>
 <div class="col-md-2"><select class="form-select" name="paymentStatus"><option value="">Mọi trạng thái thanh toán</option>@foreach (var s in (string[])ViewBag.PaymentStatuses) { <option value="@s" selected="@(ViewBag.PaymentStatus == s)">@s</option> }</select></div>
 <div class="col-md-2"><input class="form-control" type="date" name="fromDate" value="@ViewBag.FromDate" /></div><div class="col-md-2"><input class="form-control" type="date" name="toDate" value="@ViewBag.ToDate" /></div>
 <input type="hidden" name="sort" value="@ViewBag.Sort"/><input type="hidden" name="direction" value="@ViewBag.Direction"/>
 <div class="col-md-3"><button class="btn btn-primary">Lọc</button> <a class="btn btn-outline-secondary" href="@Url.Action("Index")">Xóa lọc</a></div>
</form>
@if (!Model.Any()) { <div class="alert alert-info">KHÔNG CÓ đơn hàng phù hợp.</div> } else {
<table class="table table-striped"><thead><tr><th>Mã đơn</th><th><a href="@Url.Action("Index",new{customerName=ViewBag.CustomerName,paymentStatus=ViewBag.PaymentStatus,fromDate=ViewBag.FromDate,toDate=ViewBag.ToDate,sort="customer",direction=(ViewBag.Sort=="customer"&&ViewBag.Direction=="asc"?"desc":"asc")})">Khách hàng ↕</a></th><th><a href="@Url.Action("Index",new{customerName=ViewBag.CustomerName,paymentStatus=ViewBag.PaymentStatus,fromDate=ViewBag.FromDate,toDate=ViewBag.ToDate,sort="date",direction=(ViewBag.Sort=="date"&&ViewBag.Direction=="asc"?"desc":"asc")})">Ngày đặt ↕</a></th><th><a href="@Url.Action("Index",new{customerName=ViewBag.CustomerName,paymentStatus=ViewBag.PaymentStatus,fromDate=ViewBag.FromDate,toDate=ViewBag.ToDate,sort="total",direction=(ViewBag.Sort=="total"&&ViewBag.Direction=="asc"?"desc":"asc")})">Tổng tiền ↕</a></th><th>Thanh toán</th><th><a href="@Url.Action("Index",new{customerName=ViewBag.CustomerName,paymentStatus=ViewBag.PaymentStatus,fromDate=ViewBag.FromDate,toDate=ViewBag.ToDate,sort="status",direction=(ViewBag.Sort=="status"&&ViewBag.Direction=="asc"?"desc":"asc")})">Trạng thái ↕</a></th><th></th></tr></thead><tbody>
@foreach (var o in Model) { <tr><td>#@o.OrderID</td><td>@o.Customer.CustomerName</td><td>@o.OrderDate.ToString("dd/MM/yyyy")</td><td>@o.TotalAmount.ToString("N0") VNĐ</td><td>@o.PaymentStatus</td><td>@o.OrderStatus</td><td>@Html.ActionLink("Chi tiết", "Details", new { id = o.OrderID }, new { @class = "btn btn-sm btn-primary" })</td></tr> }
</tbody></table>
<nav><ul class="pagination">@for (int i = 1; i <= (int)ViewBag.TotalPages; i++) { <li class="page-item @(i == (int)ViewBag.Page ? "active" : "")"><a class="page-link" href="@Url.Action("Index", new { customerName = ViewBag.CustomerName, paymentStatus = ViewBag.PaymentStatus, fromDate = ViewBag.FromDate, toDate = ViewBag.ToDate, sort=ViewBag.Sort, direction=ViewBag.Direction, page = i })">@i</a></li> }</ul></nav> }
