@model IEnumerable<baitapBE_22DH111429.Models.Product>
@{ ViewBag.Title="Quản lý hàng hóa"; Layout="~/Areas/Admin/Views/Shared/_Layout.cshtml"; }
<h2>Quản lý hàng hóa</h2>
@if(TempData["Success"]!=null){<div class="alert alert-success">@TempData["Success"]</div>} @if(TempData["Error"]!=null){<div class="alert alert-danger">@TempData["Error"]</div>}
<p>@Html.ActionLink("Thêm sản phẩm","Create",null,new{@class="btn btn-primary"})</p>
<form method="get" class="row g-2 mb-3"><div class="col-md-4"><input name="search" value="@ViewBag.Search" class="form-control" placeholder="Tên sản phẩm"/></div><div class="col-md-4">@Html.DropDownList("categoryId",(SelectList)ViewBag.Categories,"Tất cả danh mục",new{@class="form-select"})</div><div class="col-md-4"><button class="btn btn-outline-primary">Lọc</button></div></form>
<table class="table table-striped"><thead><tr><th>Ảnh</th><th>Tên hàng hóa</th><th>Chủng loại</th><th>Giá</th><th>Số lượng tồn</th><th>Thao tác</th></tr></thead><tbody>@foreach(var p in Model){<tr><td>@if(!String.IsNullOrEmpty(p.ProductImage)){<img src="@Url.Content(p.ProductImage)" alt="@p.ProductName" style="width:55px;height:55px;object-fit:contain"/>}</td><td>@p.ProductName</td><td>@p.Category.CategoryName</td><td>@p.ProductPrice.ToString("N0") VNĐ</td><td>@p.Quantity</td><td>@Html.ActionLink("Chi tiết","Details",new{id=p.ProductID},new{@class="btn btn-sm btn-outline-secondary"}) @Html.ActionLink("Sửa","Edit",new{id=p.ProductID},new{@class="btn btn-sm btn-outline-primary"}) @Html.ActionLink("Xóa","Delete",new{id=p.ProductID},new{@class="btn btn-sm btn-outline-danger"})</td></tr>}</tbody></table>
@if((int)ViewBag.TotalPages>1){<nav><ul class="pagination">@for(int i=1;i<=(int)ViewBag.TotalPages;i++){<li class="page-item @(i==(int)ViewBag.Page?"active":"")"><a class="page-link" href="@Url.Action("Index",new{search=ViewBag.Search,categoryId=ViewBag.CategoryId,page=i})">@i</a></li>}</ul></nav>}
