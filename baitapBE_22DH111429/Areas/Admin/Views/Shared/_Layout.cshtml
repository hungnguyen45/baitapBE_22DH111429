
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Admin MyStore</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
</head>
<body>
    <nav class="navbar navbar-dark bg-dark navbar-expand-lg">
        <div class="container">
            <a class="navbar-brand" href="@Url.Action("Index", "Home", new { area = "Admin" })">
                MyStore Admin
            </a>
            <div class="navbar-nav">
                <a class="nav-link" href="@Url.Action("Index", "Home", new { area = "Admin" })">Dashboard</a>
                <a class="nav-link" href="#">Danh mục</a>
                <a class="nav-link" href="#">Sản phẩm</a>
                <a class="nav-link" href="#">Đơn hàng</a>
                <a class="nav-link" href="#">Khách hàng</a>
            </div>
        </div>
    </nav>

    <main class="container body-content mt-4">
        @RenderBody()
        <hr />
        <footer>
            <p>&copy; @DateTime.Now.Year - MyStore Admin</p>
        </footer>
    </main>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>
