@model IEnumerable<baitapBE_22DH111429.Models.Order>
@if(!Model.Any()){<p class="text-muted">Khách hàng chưa có đơn hàng.</p>}else{<table class="table table-sm table-striped"><thead><tr><th>Mã đơn</th><th>Ngày</th><th>Trạng thái</th><th>Tổng tiền</th><th></th></tr></thead><tbody>@foreach(var o in Model){<tr><td>#@o.OrderID</td><td>@o.OrderDate.ToString("dd/MM/yyyy")</td><td>@o.OrderStatus</td><td>@o.TotalAmount.ToString("N0") VNĐ</td><td>@Html.ActionLink("Chi tiết","Details","Orders",new{area="Admin",id=o.OrderID},new{@class="btn btn-sm btn-outline-primary"})</td></tr>}</tbody></table>}
