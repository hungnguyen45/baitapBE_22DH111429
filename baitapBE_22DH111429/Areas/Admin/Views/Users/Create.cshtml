@model baitapBE_22DH111429.Models.AdminUserEditViewModel
@{ViewBag.Title="Thêm quản trị viên";Layout="~/Areas/Admin/Views/Shared/_Layout.cshtml";}
<h2>Thêm tài khoản quản trị</h2>
@using(Html.BeginForm()){ @Html.AntiForgeryToken() @Html.ValidationSummary(true,"",new{@class="text-danger"})<div class="mb-3">@Html.LabelFor(m=>m.Username,"Tên đăng nhập",new{@class="form-label"})@Html.TextBoxFor(m=>m.Username,new{@class="form-control",maxlength="255"})@Html.ValidationMessageFor(m=>m.Username,"",new{@class="text-danger"})</div><div class="mb-3">@Html.LabelFor(m=>m.Password,"Mật khẩu",new{@class="form-label"})@Html.PasswordFor(m=>m.Password,new{@class="form-control",autocomplete="new-password"})@Html.ValidationMessageFor(m=>m.Password,"",new{@class="text-danger"})</div><div class="mb-3">@Html.LabelFor(m=>m.ConfirmPassword,"Xác nhận mật khẩu",new{@class="form-label"})@Html.PasswordFor(m=>m.ConfirmPassword,new{@class="form-control",autocomplete="new-password"})@Html.ValidationMessageFor(m=>m.ConfirmPassword,"",new{@class="text-danger"})</div><button class="btn btn-primary">Tạo tài khoản</button> <a class="btn btn-secondary" href="@Url.Action("Index")">Hủy</a>}
