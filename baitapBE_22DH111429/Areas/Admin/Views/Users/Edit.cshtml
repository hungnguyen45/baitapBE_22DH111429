@model baitapBE_22DH111429.Models.AdminUserEditViewModel
@{ViewBag.Title="Sửa quản trị viên";Layout="~/Areas/Admin/Views/Shared/_Layout.cshtml";}
<h2>Sửa tài khoản quản trị</h2>
@using(Html.BeginForm()){ @Html.AntiForgeryToken() @Html.HiddenFor(m=>m.Username)<div class="mb-3"><label class="form-label">Tên đăng nhập</label><input class="form-control" value="@Model.Username" disabled/></div>@Html.ValidationSummary(true,"",new{@class="text-danger"})<div class="mb-3">@Html.LabelFor(m=>m.Password,"Mật khẩu mới (để trống nếu không đổi)",new{@class="form-label"})@Html.PasswordFor(m=>m.Password,new{@class="form-control",autocomplete="new-password"})@Html.ValidationMessageFor(m=>m.Password,"",new{@class="text-danger"})</div><div class="mb-3">@Html.LabelFor(m=>m.ConfirmPassword,"Xác nhận mật khẩu mới",new{@class="form-label"})@Html.PasswordFor(m=>m.ConfirmPassword,new{@class="form-control",autocomplete="new-password"})@Html.ValidationMessageFor(m=>m.ConfirmPassword,"",new{@class="text-danger"})</div><button class="btn btn-primary">Lưu thay đổi</button> <a class="btn btn-secondary" href="@Url.Action("Index")">Hủy</a>}
