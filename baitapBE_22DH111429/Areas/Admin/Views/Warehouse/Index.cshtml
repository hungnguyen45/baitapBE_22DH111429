@{ViewBag.Title="Quản lý kho hàng";Layout="~/Areas/Admin/Views/Shared/_Layout.cshtml"; var inStock=ViewBag.InStock as List<baitapBE_22DH111429.Models.Product>; var restock=ViewBag.NeedRestock as List<baitapBE_22DH111429.Models.Product>;}
<h2>Quản lý kho hàng</h2>
@if(TempData["Success"]!=null){<div class="alert alert-success">@TempData["Success"]</div>} @if(TempData["Error"]!=null){<div class="alert alert-danger">@TempData["Error"]</div>}
<h3>Danh sách hàng tồn</h3>
<table class="table table-striped"><thead><tr><th>Sản phẩm</th><th>Đã bán</th><th>Tồn hiện tại</th><th>Cập nhật tồn</th></tr></thead><tbody>@foreach(var p in inStock){<tr><td>@p.ProductName</td><td>@p.SoldQuantity</td><td>@p.Quantity</td><td>@using(Html.BeginForm("Update","Warehouse",FormMethod.Post,new{@class="d-flex gap-2"})){@Html.AntiForgeryToken()<input type="hidden" name="id" value="@p.ProductID"/><input type="number" name="quantity" min="0" value="@p.Quantity" class="form-control" style="max-width:130px"/><button class="btn btn-sm btn-primary">Lưu</button>}</td></tr>}</tbody></table>
<h3>Danh sách hàng cần nhập</h3>
@if(!restock.Any()){<p class="text-muted">Hiện không có sản phẩm hết hàng.</p>}else{<table class="table table-bordered"><thead><tr><th>Sản phẩm</th><th>Tồn hiện tại</th><th>Cập nhật tồn</th></tr></thead><tbody>@foreach(var p in restock){<tr><td>@p.ProductName</td><td>@p.Quantity</td><td>@using(Html.BeginForm("Update","Warehouse",FormMethod.Post,new{@class="d-flex gap-2"})){@Html.AntiForgeryToken()<input type="hidden" name="id" value="@p.ProductID"/><input type="number" name="quantity" min="0" value="0" class="form-control" style="max-width:130px"/><button class="btn btn-sm btn-primary">Lưu</button>}</td></tr>}</tbody></table>}
