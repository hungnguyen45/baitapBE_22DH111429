
@model List<baitapBE_22DH111429.Models.CartItem>

@{
    ViewBag.Title = "Giỏ hàng";
    decimal total = Model.Sum(p => p.Total);
}

<div class="container mt-4">
    <h2 class="mb-4">Giỏ hàng của bạn</h2>
    @if (TempData["Error"] != null) { <div class="alert alert-warning">@TempData["Error"]</div> }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            Giỏ hàng của bạn đang trống.
        </div>

        <a href="@Url.Action("Index", "Home")"
           class="btn btn-primary">
            Tiếp tục mua sắm
        </a>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered align-middle">
                <thead class="thead-dark">
                    <tr>
                        <th>Sản phẩm</th>
                        <th>Đơn giá</th>
                        <th>Số lượng</th>
                        <th>Thành tiền</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center">
                                    @if (!string.IsNullOrEmpty(item.ProductImage))
                                    {
                                        <img src="@Url.Content(item.ProductImage)"
                                             style="width:70px;height:70px;object-fit:contain;"
                                             class="mr-3" />
                                    }

                                    <strong>@item.ProductName</strong>
                                </div>
                            </td>

                            <td>@item.ProductPrice.ToString("N0") VNĐ</td>

                            <td>
                                @using (Html.BeginForm("Update", "Cart", FormMethod.Post))
                                {
                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="id"
                                           value="@item.ProductID" />

                                    <input type="number"
                                           name="quantity"
                                           value="@item.Quantity"
                                           min="0"
                                           style="width:70px;" />

                                    <button type="submit"
                                            class="btn btn-sm btn-primary">
                                        Cập nhật
                                    </button>
                                }
                            </td>

                            <td class="text-danger">
                                @item.Total.ToString("N0") VNĐ
                            </td>

                            <td>
                                @using (Html.BeginForm("Remove", "Cart", FormMethod.Post))
                                {
                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="id"
                                           value="@item.ProductID" />

                                    <button type="submit"
                                            class="btn btn-sm btn-danger">
                                        Xóa
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="text-right mt-4">
            <h4>
                Tổng tiền:
                <span class="text-danger">
                    @total.ToString("N0") VNĐ
                </span>
            </h4>

            <a href="@Url.Action("Index", "Home")"
               class="btn btn-secondary">
                Tiếp tục mua sắm
            </a>
            <a href="@Url.Action("Index", "Checkout")" class="btn btn-success ms-2">Tiến hành thanh toán</a>
        </div>
    }
</div>
