@model baitapBE_22DH111429.Models.Product
@{ ViewBag.Title = "Chi tiết sản phẩm"; }
@Html.Partial("~/Views/Shared/_ProductDetails.cshtml", Model)
@if (Model.Quantity > 0) { using (Html.BeginForm("Add", "Cart", FormMethod.Post, new { @class = "mt-3" })) { @Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.ProductID"/><label for="quantity">Số lượng</label><input id="quantity" name="quantity" type="number" min="1" max="@Model.Quantity" value="1" class="form-control mb-3" style="max-width:120px"/><button class="btn btn-primary">Thêm vào giỏ hàng</button> } } else { <div class="alert alert-warning">Sản phẩm tạm hết hàng.</div> }
<a href="@Url.Action("Index","Category")" class="btn btn-outline-secondary mt-3">Quay lại sản phẩm</a>
