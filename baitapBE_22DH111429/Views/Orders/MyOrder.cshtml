@model baitapBE_22DH111429.Models.CustomerOrdersViewModel
@{ ViewBag.Title = "Đơn hàng của tôi"; Layout = "~/Views/Shared/_CustomerLayout.cshtml"; }
<h2>Đơn hàng của tôi</h2>
@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
<form method="get" class="row g-2 mb-3"><div class="col-md-8"><input class="form-control" name="search" value="@Model.Search" placeholder="Tìm mã đơn hoặc tên sản phẩm" /></div><div class="col-md-2"><button class="btn btn-primary">Tìm kiếm</button></div></form>
<ul class="nav nav-tabs mb-3"><li class="nav-item"><a class="nav-link @(Model.ActiveStatus == "Tất cả" ? "active" : "")" href="@Url.Action("MyOrder", new { search = Model.Search, status = "Tất cả" })">Tất cả đơn</a></li>@foreach (var s in new[] { "Chờ thanh toán", "Đang xử lý", "Đang vận chuyển", "Đã giao", "Đã hủy" }) { <li class="nav-item"><a class="nav-link @(Model.ActiveStatus == s ? "active" : "")" href="@Url.Action("MyOrder", new { search = Model.Search, status = s })">@s</a></li> }</ul>
@if (!Model.Groups.Any(g => g.Orders.Any())) { if (!Model.HasAnyOrders) { <div class="alert alert-info">BẠN CHƯA CÓ ĐƠN HÀNG NÀO. HÃY ĐẶT ĐƠN NGAY. <a href="@Url.Action("Index", "Home")">Về trang chủ</a></div> } else { <div class="alert alert-info">Không có đơn hàng phù hợp với lựa chọn hiện tại.</div> } }
@foreach (var group in Model.Groups) { if (group.Orders.Any()) { <section class="mb-4"><h4>@group.Status</h4>@foreach (var order in group.Orders) { <div class="card mb-3"><div class="card-header d-flex justify-content-between"><span>Đơn #@order.OrderID · @order.OrderDate.ToString("dd/MM/yyyy")</span><strong>@order.TotalAmount.ToString("N0") VNĐ</strong></div><div class="card-body">@foreach (var line in order.OrderDetail) { <div class="d-flex justify-content-between border-bottom py-2"><a href="@Url.Action("Details", "Home", new { id = line.ProductID })">@line.Product.ProductName</a> <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Details", "Home", new { id = line.ProductID })">Xem chi tiết</a><span>@line.Quantity × @line.UnitPrice.ToString("N0") VNĐ</span></div> }<div class="mt-3"><span>Thanh toán: @order.PaymentStatus</span> <a class="btn btn-sm btn-outline-secondary ms-2" href="@Url.Action("Details", "Orders", new { id = order.OrderID })">Xem hóa đơn</a>@using (Html.BeginForm("BuyAgain", "Orders", FormMethod.Post, new { @class = "d-inline ms-3" })) { @Html.AntiForgeryToken()<input type="hidden" name="id" value="@order.OrderID"/><button class="btn btn-sm btn-outline-primary">Mua lại</button> }</div></div></div> }@if (group.HasMore) { <a class="btn btn-outline-secondary btn-sm" href="@Url.Action("MyOrder", new { search = Model.Search, status = Model.ActiveStatus, expand = group.Status })">Xem thêm (tối đa 50)</a> }</section> } }
