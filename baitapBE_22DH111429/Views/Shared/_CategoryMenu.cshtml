    <ul class="dropdown-menu">
        <li><a class="dropdown-item" href="@Url.Action("Index", "Category")">Tất cả sản phẩm</a></li>
        @foreach (var c in Model) { <li><a class="dropdown-item" href="@Url.Action("Index", "Category", new { categoryId = c.CategoryID })">@c.CategoryName</a></li> }
    </ul>
</div>
