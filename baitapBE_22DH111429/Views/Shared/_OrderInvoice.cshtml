@model baitapBE_22DH111429.Models.Order
<div class="card mb-3"><div class="card-body"><h5>Thông tin khách hàng</h5><p>@Model.Customer.CustomerName · @Model.Customer.CustomerPhone · @Model.Customer.CustomerEmail</p><p><strong>Địa chỉ giao hàng:</strong> @Model.AddressDelivery</p><p><strong>Ngày đặt:</strong> @Model.OrderDate.ToString("dd/MM/yyyy")</p><p><strong>Trạng thái đơn:</strong> @Model.OrderStatus · <strong>Thanh toán:</strong> @Model.PaymentStatus</p></div></div>
<div class="table-responsive"><table class="table table-bordered"><thead><tr><th>Sản phẩm</th><th>Đơn giá</th><th>Số lượng</th><th>Thành tiền</th></tr></thead><tbody>@foreach(var line in Model.OrderDetail){<tr><td>@line.Product.ProductName</td><td>@line.UnitPrice.ToString("N0") VNĐ</td><td>@line.Quantity</td><td>@((line.UnitPrice*line.Quantity).ToString("N0")) VNĐ</td></tr>}</tbody><tfoot><tr><th colspan="3" class="text-end">Tổng cộng</th><th>@Model.TotalAmount.ToString("N0") VNĐ</th></tr></tfoot></table></div>
