@model baitapBE_22DH111429.Models.Product
<div class="row g-4"><div class="col-md-5">@if (!String.IsNullOrWhiteSpace(Model.ProductImage)) { <img src="@Url.Content(Model.ProductImage)" alt="@Model.ProductName" class="img-fluid" style="max-height:420px;object-fit:contain"/> }</div><div class="col-md-7"><h2>@Model.ProductName</h2><p><strong>Danh mục:</strong> @(Model.Category == null ? "" : Model.Category.CategoryName)</p><p class="text-danger fs-4">@Model.ProductPrice.ToString("N0") VNĐ</p><p><strong>Mô tả:</strong> @Model.ProductDecription</p><p><strong>Tồn kho:</strong> @Model.Quantity</p><p><strong>Đã bán:</strong> @Model.SoldQuantity</p></div></div>
